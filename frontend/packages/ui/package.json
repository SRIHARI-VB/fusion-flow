{
  "name": "@fusion-flow/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Shared Tailwind-styled component primitives + theme tokens for fusion-flow. Consumed by frontend/web and frontend/admin directly from source (no build step) — see README.md for rationale.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./tailwind.preset": "./tailwind.config.ts"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4",
    "lucide-react": "^0.451.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
