# Copy this file to `.env` and adjust values for your local setup.
# None of these defaults are production-safe.

# Migration/owner-role connection string. Alembic always uses this one.
# Must use the asyncpg driver.
DATABASE_URL=postgresql+asyncpg://fusionflow:fusionflow@localhost:5432/fusionflow

# Optional: the connection the *running app* actually queries as. Must be
# a dedicated non-superuser, non-BYPASSRLS role for RLS to apply to it -
# Supabase's default `postgres` role is NOT a superuser but DOES have
# rolbypassrls=true, which bypasses every tenant_isolation policy just as
# completely as a superuser would. Falls back to DATABASE_URL if unset
# (fine for a local Postgres where the one role you use is already
# low-privilege).
#
# Using `infra/docker/docker-compose.dev.yml`? The `fusionflow_app` role
# and this exact password are created for you automatically on first boot
# (infra/docker/initdb/01-create-app-role.sql) - just uncomment the line
# below as-is.
#
# Anywhere else (manual Postgres, a shared/remote instance), create the
# role once yourself:
#   CREATE ROLE fusionflow_app LOGIN PASSWORD '...' NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE;
#   GRANT USAGE ON SCHEMA public TO fusionflow_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO fusionflow_app;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO fusionflow_app;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO fusionflow_app;
# RUNTIME_DATABASE_URL=postgresql+asyncpg://fusionflow_app:fusionflow_app_dev_only@localhost:5432/fusionflow

# Symmetric secret used to sign/verify JWTs (HS256). Must be at least 32
# bytes per RFC 7518 s3.2. Any long random string in dev; use a real secret
# manager value in any shared/prod environment. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-jwt-secret-0123456789abcdef

JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Cache backend toggle. false -> InMemoryCacheBackend (no Redis required).
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# Background-job backend toggle. false -> InProcessAsyncQueue (asyncio
# tasks, no broker required). true selects CeleryQueue, which is a stub in
# Wave 0 and raises NotImplementedError on startup.
BACKGROUND_JOBS_ENABLED=false

# AI subsystem toggle. false -> modules/ai registers nothing, langchain/
# langgraph are never imported.
AI_ENABLED=false

# Fernet key (urlsafe-base64, 32 raw bytes) used by core/encryption.py for
# envelope-encrypting connector secrets. Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# THIS DEFAULT IS NOT PROD-SAFE - it is a fixed dev-only value so the app
# boots out of the box. Rotate via ENCRYPTION_KEY + a new
# encryption_key_version for any real deployment; never reuse this value
# outside local development.
ENCRYPTION_KEY=Ua2yuHtia0s-2FhOZ4pQmyoVoFYIP5wsE7mYNzOD3Vw=

ENVIRONMENT=development

# Comma-separated list of allowed CORS origins for the two frontend dev apps.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
